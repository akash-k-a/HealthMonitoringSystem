{
  "name": "elderly-care-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Collaborative Elderly Healthcare Management Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "npm run --workspaces --if-present test",
    "lint": "npm run --workspaces --if-present lint",
    "web": "npm run --workspace=apps/web dev",
    "mobile": "npm run --workspace=apps/mobile start"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
