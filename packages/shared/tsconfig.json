{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@elderly-care/types": ["../types/dist/index.d.ts"],
      "@elderly-care/validation": ["../validation/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*"]
}
